PORT=8080
PUBLIC_BASE_URL=https://mcp.example.com
COMMAND_TIMEOUT_MS=30000

# Production: Supabase Auth + private Postgres schema.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_DATABASE_URL=postgresql://mobilegui_gateway:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DATABASE_SSL=true
DEVICE_TOKEN_PEPPER=replace-with-at-least-32-random-bytes-kept-only-on-the-gateway

# Local relay-only fallback. Remove SUPABASE_URL and its related values before
# enabling this mode. Never deploy the fallback for multiple users.
# MCP_API_TOKEN=replace-with-at-least-32-random-bytes
# DEVICE_API_TOKEN=use-a-different-at-least-32-byte-random-value
# DEVICE_ID=development-phone
