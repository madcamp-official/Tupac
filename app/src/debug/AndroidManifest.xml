<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:usesCleartextTraffic="true">
        <!-- ADB may inject a goal without covering the app under test. The
             release manifest keeps this receiver private. -->
        <receiver
            android:name=".cloud.GeminiCommandReceiver"
            android:exported="true"
            tools:replace="android:exported" />

        <receiver
            android:name=".debug.GeminiOcrBenchmarkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.mobileguiagent.BENCHMARK_GEMINI_LEGACY" />
                <action android:name="com.example.mobileguiagent.BENCHMARK_GEMINI_FUSED_OCR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
